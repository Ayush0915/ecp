# Copy this file to .env and fill it in. .env is ignored by git; never commit it.

# Azure OpenAI
AZURE_OPENAI_BASE=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=YOUR-CHAT-DEPLOYMENT
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=

# Or leave the key empty and use a service principal:
AZURE_OPENAI_TENANTID=
AZURE_OPENAI_CLIENTID=
AZURE_OPENAI_CLIENTSECRET=

# Only for private GitHub repositories (read access is enough)
GITHUB_TOKEN=
